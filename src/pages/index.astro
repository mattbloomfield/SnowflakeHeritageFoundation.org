---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Snowflake Heritage Foundation — Preserving Pioneer History in Snowflake, Arizona"
  description="The Snowflake Heritage Foundation preserves historic homes, artifacts, and stories from Snowflake, Arizona's pioneering past. Visit the Stinson Museum."
>
  <!-- Hero -->
  <section class="relative">
    <!-- TODO: Replace with actual Stinson Museum photo -->
    <div class="img-placeholder min-h-[400px] md:min-h-[500px]" aria-label="Stinson Museum exterior photograph">
      <span>Stinson Museum exterior photograph</span>
    </div>
    <div class="bg-parchment/95 md:absolute md:bottom-0 md:left-0 md:right-0">
      <div class="max-w-content mx-auto px-6 py-8 md:py-10">
        <h1 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-charcoal leading-tight mb-4">
          Preserving the Pioneer Heritage of Snowflake, Arizona
        </h1>
        <p class="text-charcoal/80 text-lg md:text-xl mb-6 max-w-2xl">
          The Snowflake Heritage Foundation stewards the oldest homes and stories of our community&nbsp;&mdash; since the days of the first settlers.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/contact"
            class="inline-block font-label text-xs tracking-[0.15em] uppercase px-6 py-3 bg-terracotta text-parchment border-b-4 border-terracotta/70 hover:bg-terracotta/90 transition-colors"
          >
            Plan Your Visit
          </a>
          <a
            href="/donate"
            class="inline-block font-label text-xs tracking-[0.15em] uppercase px-6 py-3 bg-gold text-parchment border-b-4 border-gold/70 hover:bg-gold/90 transition-colors"
          >
            Support Our Work
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Strip -->
  <section class="bg-dark text-parchment">
    <div class="max-w-content mx-auto px-6 py-12 text-center">
      <p class="font-display text-xl md:text-2xl italic leading-relaxed">
        &ldquo;Our mission is to preserve, protect, and promote the historic homes, artifacts, and stories that define Snowflake&rsquo;s pioneering past.&rdquo;
      </p>
    </div>
  </section>

  <!-- Hours at a Glance -->
  <section class="bg-parchment">
    <div class="max-w-content mx-auto px-6 py-12">
      <div class="border-2 border-tan px-8 py-6 max-w-md mx-auto text-center">
        <h2 class="font-label text-xs tracking-[0.2em] uppercase text-terracotta mb-4">Museum Hours</h2>
        <p class="mb-1">Monday &ndash; Saturday: 10:00 AM &ndash; 2:00 PM</p>
        <p class="mb-4">Closed Sunday</p>
        <p class="text-base text-charcoal/70">
          Tours by appointment: call the Chamber at <a href="tel:9285364331" class="text-terracotta hover:underline">(928) 536-4331</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Brief History -->
  <section class="bg-parchment">
    <div class="max-w-content mx-auto px-6 pb-12">
      <hr class="ornamental-rule" />
      <h2 class="font-display text-2xl md:text-3xl font-bold mb-6 text-center">A Story That Starts in the 1870s</h2>
      <div class="max-w-2xl mx-auto">
        <p class="mb-4">
          Snowflake was settled in the 1870s by James Stinson, who supplied cattle to Western military outposts. In 1878, he sold his ranch to William J. Flake&nbsp;&mdash; the town&rsquo;s name is a tribute to both Erastus Snow and William Flake, the Mormon pioneers who established the community.
        </p>
        <p>
          Today, more than 100 historic homes remain in Snowflake, with 45 listed on the National Register of Historic Places.
        </p>
      </div>
    </div>
  </section>

  <!-- Donate CTA -->
  <section class="bg-dark text-parchment">
    <div class="max-w-content mx-auto px-6 py-12 text-center">
      <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">Support Local History</h2>
      <p class="mb-6 text-parchment/80 max-w-xl mx-auto">
        Your donation keeps our doors open and our stories alive. Donate easily through Venmo&nbsp;&mdash; every contribution helps.
      </p>
      <a
        href="https://venmo.com/u/SnowflakeHeritageFoundation"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block font-label text-xs tracking-[0.15em] uppercase px-8 py-3 bg-gold text-parchment border-b-4 border-gold/70 hover:bg-gold/90 transition-colors"
      >
        Donate via Venmo
      </a>
    </div>
  </section>
</Layout>
